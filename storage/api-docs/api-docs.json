{
    "openapi": "3.0.0",
    "info": {
        "title": "World API",
        "description": "API для получения информации связанной с окружающим миром.",
        "contact": {
            "email": "https://github.com/Salfetka08"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/weather/random-idea": {
            "get": {
                "tags": [
                    "Ideas"
                ],
                "summary": "Получить случайную идею о погоде",
                "description": "Возвращает случайную идею, связанную с погодой, включая описание, настроение, время года и погодные условия",
                "operationId": "d6d530cb09b5f641340f463edddaa9db",
                "responses": {
                    "200": {
                        "description": "Успешный ответ",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "idea": {
                                            "description": "Случайная идея о погоде",
                                            "properties": {
                                                "description": {
                                                    "description": "Описание погодной идеи",
                                                    "type": "string",
                                                    "example": "Легкий снежок кружится под фонарями, создавая новогоднее настроение"
                                                },
                                                "mood": {
                                                    "description": "Настроение, которое создает погода",
                                                    "type": "string",
                                                    "example": "Сказочная"
                                                },
                                                "season": {
                                                    "description": "Время года",
                                                    "type": "string",
                                                    "enum": [
                                                        "Зима",
                                                        "Весна",
                                                        "Лето",
                                                        "Осень"
                                                    ],
                                                    "example": "Зима"
                                                },
                                                "weather_type": {
                                                    "description": "Тип погоды",
                                                    "type": "string",
                                                    "enum": [
                                                        "Снежно",
                                                        "Дождливо",
                                                        "Облачно",
                                                        "Гроза",
                                                        "Туманно",
                                                        "Солнечно"
                                                    ],
                                                    "example": "Снежно"
                                                },
                                                "color_palette": {
                                                    "description": "Цветовая палитра, ассоциирующаяся с погодой",
                                                    "type": "string",
                                                    "example": "Холодные тона",
                                                    "nullable": true
                                                },
                                                "has_rainbow": {
                                                    "description": "Наличие радуги",
                                                    "type": "boolean",
                                                    "example": true,
                                                    "nullable": true
                                                },
                                                "has_wind": {
                                                    "description": "Наличие ветра",
                                                    "type": "boolean",
                                                    "example": true,
                                                    "nullable": true
                                                },
                                                "has_fog": {
                                                    "description": "Наличие тумана",
                                                    "type": "boolean",
                                                    "example": true,
                                                    "nullable": true
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера"
                    }
                }
            }
        },
        "/api/v1/world/current": {
            "post": {
                "tags": [
                    "World"
                ],
                "summary": "Получить текущую информацию о мире",
                "description": "Возвращает текущие погодные условия, время суток и сезон для указанного пользователя",
                "operationId": "f1da69d8540674d5048fdce6309ef53e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "userId"
                                ],
                                "properties": {
                                    "userId": {
                                        "description": "ID пользователя",
                                        "type": "integer",
                                        "example": 123
                                    },
                                    "latitude": {
                                        "description": "Широта (опционально)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 55.7558
                                    },
                                    "longitude": {
                                        "description": "Долгота (опционально)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 37.6176
                                    },
                                    "timestamp": {
                                        "description": "Время запроса (опционально)",
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-03-01T15:30:00Z"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успешный ответ",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "userId": {
                                            "type": "integer",
                                            "example": 123
                                        },
                                        "location": {
                                            "type": "string",
                                            "example": "Москва"
                                        },
                                        "weather": {
                                            "properties": {
                                                "temperature": {
                                                    "type": "integer",
                                                    "example": -5
                                                },
                                                "feelsLike": {
                                                    "type": "integer",
                                                    "example": -8
                                                },
                                                "condition": {
                                                    "type": "string",
                                                    "enum": [
                                                        "CLEAR",
                                                        "CLOUDY",
                                                        "RAINY",
                                                        "SNOWY",
                                                        "STORMY"
                                                    ],
                                                    "example": "SNOWY"
                                                },
                                                "humidity": {
                                                    "type": "integer",
                                                    "example": 85
                                                },
                                                "windSpeed": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 7.5
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "dayTime": {
                                            "type": "string",
                                            "enum": [
                                                "MORNING",
                                                "AFTERNOON",
                                                "EVENING",
                                                "NIGHT"
                                            ],
                                            "example": "EVENING"
                                        },
                                        "season": {
                                            "type": "string",
                                            "enum": [
                                                "SPRING",
                                                "SUMMER",
                                                "AUTUMN",
                                                "WINTER"
                                            ],
                                            "example": "WINTER"
                                        },
                                        "sunrise": {
                                            "type": "string",
                                            "format": "time",
                                            "example": "08:30"
                                        },
                                        "sunset": {
                                            "type": "string",
                                            "format": "time",
                                            "example": "16:45"
                                        },
                                        "updatedAt": {
                                            "type": "string",
                                            "format": "date-time",
                                            "example": "2025-01-20T15:30:00Z"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "GetCurrentWorldRequest": {
                "description": "Запрос на получение текущей информации о мире"
            }
        }
    },
    "tags": [
        {
            "name": "World",
            "description": "Информация о текущем окружающем мире."
        },
        {
            "name": "Ideas",
            "description": "Ideas"
        }
    ]
}